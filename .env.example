# Environment Variables
# Create a copy of this file as .env.local and fill in your values

# Google Maps JavaScript API Key
# Enable: Maps JavaScript API, Maps Embed API
# Get your key at: https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Optional: Google Maps Map ID (for cloud-based map styling)
# VITE_GOOGLE_MAPS_MAP_ID=
